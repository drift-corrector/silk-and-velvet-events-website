---
interface Props {
  name: string;
  role: string;
}
const { name, role } = Astro.props;
function initials(n: string): string {
  return n.split(/\s+/).map((p) => p[0]).join('').toUpperCase().slice(0, 2);
}
---

<article class="team__card">
  <div class="team__avatar" aria-hidden="true">{initials(name)}</div>
  <div>
    <h3 class="team__name">{name}</h3>
    <p class="team__role">{role}</p>
    <div class="team__bio"><slot /></div>
  </div>
</article>

<style>
  .team__card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1.5rem;
    align-items: start;
    background: var(--cream);
    padding: 2rem;
    border-radius: var(--r-lg);
    border: 1px solid color-mix(in oklch, var(--ink) 6%, transparent);
  }
  .team__avatar {
    width: 96px; height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--blush));
    display: grid; place-items: center;
    font-family: var(--serif);
    font-size: 1.85rem;
    color: var(--burgundy);
    font-weight: 500;
  }
  .team__name {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .team__role {
    color: var(--burgundy);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0.25rem 0 1rem;
  }
  .team__bio { color: var(--ink-soft); font-size: 1rem; line-height: 1.6; }
  .team__bio :global(p:first-child) { margin-top: 0; }
  @media (max-width: 600px) {
    .team__card { grid-template-columns: 1fr; }
  }
</style>
