---
import { getCollection } from 'astro:content';
const steps = (await getCollection('process')).sort((a, b) => a.data.step - b.data.step);
---

<ol class="process__row">
  {steps.map((s) => (
    <li class="step">
      <div class="step__num">{String(s.data.step).padStart(2, '0')}</div>
      <h3 class="step__name">{s.data.name}</h3>
      <p class="step__desc">{s.data.description}</p>
    </li>
  ))}
</ol>

<style>
  .process__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 1100px;
    margin: 0 auto;
    list-style: none;
    padding: 0;
  }
  .step {
    background: var(--cream);
    border-radius: var(--r-lg);
    padding: 1.5rem;
    border: 1px solid color-mix(in oklch, var(--ink) 6%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
  }
  .step__num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--gold);
    line-height: 1;
  }
  .step__name {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
  }
  .step__desc {
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 0;
  }
  @media (max-width: 880px) { .process__row { grid-template-columns: repeat(2, 1fr); } }
</style>
