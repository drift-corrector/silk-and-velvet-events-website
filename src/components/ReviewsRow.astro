---
import { getCollection } from 'astro:content';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const all = (await getCollection('reviews')).sort((a, b) => b.data.year - a.data.year);
const reviews = limit ? all.slice(0, limit) : all;

function initials(name: string): string {
  return name.split(/\s+/).map((p) => p[0]).join('').toUpperCase().slice(0, 2);
}
---

<div class="reviews__row">
  {reviews.map((r) => (
    <article class="review">
      <div class="review__stars" aria-label={`${r.data.rating} out of 5 stars`}>
        {'★'.repeat(r.data.rating)}
      </div>
      <blockquote class="review__quote">{r.data.quote}</blockquote>
      <footer class="review__attr">
        <div class="avatar" aria-hidden="true">{initials(r.data.authorName)}</div>
        <div>
          <strong>{r.data.authorName}</strong>
          <span>{r.data.eventType} · {r.data.year}</span>
        </div>
      </footer>
    </article>
  ))}
</div>

<style>
  .reviews__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 1320px;
    margin: 0 auto;
  }
  .review {
    background: var(--cream);
    padding: 2rem;
    border-radius: var(--r-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid color-mix(in oklch, var(--ink) 5%, transparent);
  }
  .review__stars { color: var(--gold); font-size: 0.95rem; letter-spacing: 2px; }
  .review__quote {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
    flex: 1;
    quotes: '“' '”';
  }
  .review__quote::before { content: open-quote; }
  .review__quote::after { content: close-quote; }
  .review__attr {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in oklch, var(--ink) 8%, transparent);
  }
  .avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--blush));
    display: grid; place-items: center;
    font-family: var(--serif);
    font-size: 0.92rem;
    color: var(--burgundy);
    font-weight: 500;
  }
  .review__attr div { display: flex; flex-direction: column; }
  .review__attr strong { font-family: var(--sans); font-size: 0.92rem; font-weight: 500; }
  .review__attr span { font-size: 0.78rem; color: var(--ink-soft); }
  @media (max-width: 880px) { .reviews__row { grid-template-columns: 1fr; } }
</style>
