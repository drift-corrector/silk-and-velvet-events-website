---
import { getCollection } from 'astro:content';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const all = (await getCollection('reviews')).sort((a, b) => b.data.year - a.data.year);
const reviews = limit ? all.slice(0, limit) : all;
const [featured, ...rest] = reviews;
---

<div class="quotes">
  {featured && (
    <article class="featured">
      <div class="featured__stars" aria-label={`${featured.data.rating} out of 5 stars`}>
        {'★'.repeat(featured.data.rating)}
      </div>
      <blockquote class="featured__quote">{featured.data.quote}</blockquote>
      <span class="featured__rule" aria-hidden="true"></span>
      <footer class="featured__attr">
        <strong>{featured.data.authorName}</strong>
        <span> · {featured.data.eventType} · {featured.data.year}</span>
      </footer>
    </article>
  )}

  {rest.length > 0 && (
    <div class="rest">
      {rest.map((r) => (
        <article class="quote">
          <div class="quote__stars" aria-label={`${r.data.rating} out of 5 stars`}>
            {'★'.repeat(r.data.rating)}
          </div>
          <blockquote class="quote__text">{r.data.quote}</blockquote>
          <footer class="quote__attr">
            <strong>{r.data.authorName}</strong>
            <span> · {r.data.eventType} · {r.data.year}</span>
          </footer>
        </article>
      ))}
    </div>
  )}
</div>

<style>
  .quotes {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .featured {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .featured__stars {
    color: var(--gold);
    font-size: 1rem;
    letter-spacing: 0.4em;
  }
  .featured__quote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.4rem, 3vw, 2.15rem);
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
    quotes: '“' '”' '‘' '’';
    letter-spacing: -0.005em;
  }
  .featured__quote::before {
    content: open-quote;
  }
  .featured__quote::after {
    content: close-quote;
  }
  .featured__rule {
    display: block;
    width: 48px;
    height: 1px;
    background: color-mix(in oklch, var(--gold) 70%, transparent);
    margin-top: 0.5rem;
  }
  .featured__attr {
    font-family: var(--sans);
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .featured__attr strong {
    color: var(--burgundy);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .rest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.75rem 3.5rem;
  }
  .quote {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .quote__stars {
    color: var(--gold);
    font-size: 0.85rem;
    letter-spacing: 0.32em;
  }
  .quote__text {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
    quotes: '“' '”' '‘' '’';
    max-width: 38ch;
  }
  .quote__text::before {
    content: open-quote;
  }
  .quote__text::after {
    content: close-quote;
  }
  .quote__attr {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in oklch, var(--gold) 50%, transparent);
    align-self: flex-start;
    min-width: 200px;
  }
  .quote__attr strong {
    color: var(--burgundy);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 880px) {
    .quotes { gap: 3rem; }
    .rest {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .quote__text { max-width: none; }
  }
</style>
