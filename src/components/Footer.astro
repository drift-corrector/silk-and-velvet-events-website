---
import { SMS_HREF, EMAIL_HREF, INSTAGRAM_URL, FACEBOOK_URL, PHONE_DISPLAY, SERVICE_AREAS } from '~/lib/contact';

const visit = [
  { href: '/services/', label: 'Services' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/process/', label: 'Process' },
  { href: '/faq/', label: 'FAQ' },
];
const reach = [
  { href: SMS_HREF, label: `Text · ${PHONE_DISPLAY}` },
  { href: INSTAGRAM_URL, label: 'Instagram' },
  { href: FACEBOOK_URL, label: 'Facebook' },
  { href: EMAIL_HREF, label: 'Email' },
];
const year = new Date().getFullYear();
---

<footer>
  <div class="foot__grid">
    <div>
      <div class="foot__brand">
        <span class="nav__monogram" aria-hidden="true">SV</span>
        <span>Silk &amp; Velvet</span>
      </div>
      <p class="foot__tagline">Where creativity meets elegance, making your vision unforgettable.</p>
    </div>
    <div class="foot__col">
      <h4>Visit</h4>
      <ul>
        {visit.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="foot__col">
      <h4>Reach</h4>
      <ul>
        {reach.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="foot__col">
      <h4>Service Area</h4>
      <ul>
        {SERVICE_AREAS.map((area) => <li>{area}</li>)}
        <li>Travel by request</li>
      </ul>
    </div>
  </div>
  <div class="foot__bottom">
    <span>© {year} Silk &amp; Velvet Events</span>
    <span>Made in NYC</span>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--cream);
    padding: 4rem 4rem 1.5rem;
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    max-width: 1320px;
    margin: 0 auto 3rem;
  }
  .foot__brand {
    display: flex; align-items: center; gap: 14px;
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--cream);
  }
  .foot__brand .nav__monogram {
    width: 36px; height: 36px;
    background: var(--gold);
    color: var(--ink);
    border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--serif);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.05em;
  }
  .foot__tagline {
    font-family: var(--script);
    font-size: 1.6rem;
    line-height: 1.3;
    max-width: 18ch;
    margin-top: 1.25rem;
    color: color-mix(in oklch, var(--gold) 95%, var(--cream));
  }
  .foot__col h4 {
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1rem;
  }
  .foot__col ul {
    list-style: none; padding: 0; margin: 0;
    font-size: 0.95rem;
    line-height: 2;
  }
  .foot__col a { color: color-mix(in oklch, var(--cream) 80%, transparent); }
  .foot__col a:hover { color: var(--gold); }
  .foot__bottom {
    max-width: 1320px;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklch, var(--cream) 10%, transparent);
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: color-mix(in oklch, var(--cream) 50%, transparent);
  }
  @media (max-width: 880px) {
    footer { padding: 3rem 1.5rem 1.5rem; }
    .foot__grid { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
    .foot__bottom { flex-direction: column; gap: 0.5rem; }
  }
</style>
