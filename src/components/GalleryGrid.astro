---
interface Photo {
  src?: string;
  alt: string;
  caption?: string;
  variant?: 1 | 2 | 3 | 4 | 5 | 6;
}
interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;
---

<div class="gallery__grid">
  {photos.map((p, i) => (
    <figure class={`photo photo--${p.variant ?? ((i % 6) + 1)}`}>
      {p.src && <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />}
      {!p.src && <span class="sr">{p.alt}</span>}
      {p.caption && <figcaption>{p.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 1320px;
    margin: 0 auto;
  }
  .photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    position: relative;
    background: var(--blush);
    transition: transform 320ms ease;
    margin: 0;
  }
  .photo:hover { transform: scale(1.01); }
  .photo img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .photo figcaption {
    position: absolute;
    bottom: 12px; left: 14px;
    color: var(--cream);
    font-size: 0.78rem;
    background: color-mix(in oklch, var(--ink) 35%, transparent);
    padding: 5px 11px;
    border-radius: var(--r-pill);
    backdrop-filter: blur(8px);
  }
  .sr {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .photo--1 { background: linear-gradient(150deg, var(--blush), var(--tan)); }
  .photo--2 { background: linear-gradient(180deg, var(--burgundy), var(--burgundy-soft)); }
  .photo--3 { background: linear-gradient(160deg, var(--pink), var(--blush)); }
  .photo--4 { background: linear-gradient(140deg, var(--gold), var(--tan)); }
  .photo--5 { background: linear-gradient(170deg, var(--pink), var(--gold)); }
  .photo--6 { background: linear-gradient(180deg, var(--blush), var(--burgundy)); }
  @media (max-width: 880px) { .gallery__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
