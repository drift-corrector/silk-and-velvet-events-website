---
interface Photo {
  src?: string;
  alt: string;
  caption?: string;
  variant?: 1 | 2 | 3 | 4 | 5 | 6;
}
interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;
---

<div class="mosaic">
  {photos.map((p, i) => {
    const variant = p.variant ?? ((i % 6) + 1);
    return (
      <figure class={`tile tile--v${variant}`}>
        {p.src && <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />}
        {!p.src && <span class="sr">{p.alt}</span>}
        {p.caption && <figcaption>{p.caption}</figcaption>}
      </figure>
    );
  })}
</div>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(150px, 18vw);
    grid-auto-flow: dense;
    gap: 0.85rem;
    max-width: 1320px;
    margin: 0 auto;
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    margin: 0;
    background: var(--blush);
    transition: transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tile:hover {
    transform: scale(1.012);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tile figcaption {
    position: absolute;
    bottom: 12px;
    left: 14px;
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    background: color-mix(in oklch, var(--ink) 42%, transparent);
    padding: 5px 11px;
    border-radius: var(--r-pill);
    backdrop-filter: blur(10px);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 280ms ease, transform 280ms ease;
  }
  .tile:hover figcaption,
  .tile:focus-within figcaption {
    opacity: 1;
    transform: translateY(0);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .tile--v1 {
    grid-column: span 2;
    grid-row: span 2;
    border-radius: var(--r-lg);
    background:
      radial-gradient(circle at 75% 25%, color-mix(in oklch, var(--gold) 55%, transparent), transparent 55%),
      linear-gradient(150deg, var(--blush), var(--tan) 55%, var(--burgundy));
  }
  .tile--v1::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 25% 80%, color-mix(in oklch, var(--burgundy) 28%, transparent), transparent 55%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .tile--v1 figcaption {
    opacity: 1;
    transform: translateY(0);
    bottom: 18px;
    left: 20px;
    font-size: 0.84rem;
    padding: 7px 14px;
  }

  .tile--v2 {
    grid-row: span 2;
    background: linear-gradient(180deg, var(--burgundy), var(--burgundy-soft));
  }

  .tile--v3 {
    background: linear-gradient(160deg, var(--pink), var(--blush));
  }

  .tile--v4 {
    background: linear-gradient(140deg, var(--gold), var(--tan));
  }

  .tile--v5 {
    grid-column: span 2;
    background: linear-gradient(170deg, var(--pink), var(--gold));
  }

  .tile--v6 {
    grid-column: span 2;
    background: linear-gradient(180deg, var(--blush), var(--burgundy));
  }

  @media (max-width: 1100px) {
    .mosaic {
      grid-auto-rows: minmax(140px, 22vw);
    }
  }

  @media (max-width: 880px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(160px, 32vw);
      gap: 0.55rem;
    }
    .tile--v1 { grid-column: span 2; grid-row: span 2; }
    .tile--v2 { grid-row: span 2; grid-column: span 1; }
    .tile--v3, .tile--v4 { grid-column: span 1; grid-row: span 1; }
    .tile--v5, .tile--v6 { grid-column: span 2; grid-row: span 1; }
    .tile figcaption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile figcaption {
      transition: none;
    }
  }
</style>
