---
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
  slug: string;
}

const { member, slug } = Astro.props;
const { Content } = await member.render();
const { name, role, photo, photoCaption } = member.data;
---

<section class={`member member--${slug}`} id={slug}>
  <figure class="member__media">
    {photo ? (
      <img
        class="member__photo member__photo--img"
        src={photo}
        alt={`${name}, ${role} — Silk & Velvet Events`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="member__photo" aria-hidden="true"></div>
    )}
    {photoCaption && <figcaption>{photoCaption}</figcaption>}
  </figure>

  <div class="member__content">
    <p class="member__eyebrow">{role}</p>
    <h2 class="member__name">{name}</h2>
    <div class="member__bio"><Content /></div>
  </div>
</section>

<style>
  .member {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    scroll-margin-top: 90px;
  }
  .member:not(:first-of-type) {
    border-top: 1px solid color-mix(in oklch, var(--ink) 8%, transparent);
  }
  .member:nth-of-type(even) .member__media { order: 2; }

  .member__media {
    margin: 0;
    position: relative;
  }
  .member__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    position: relative;
    width: 100%;
  }
  .member__photo--img {
    object-fit: cover;
    display: block;
  }
  .member__media figcaption {
    position: absolute;
    bottom: 1rem;
    left: 1.25rem;
    color: var(--cream);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    background: color-mix(in oklch, var(--ink) 35%, transparent);
    padding: 6px 12px;
    border-radius: var(--r-pill);
    backdrop-filter: blur(8px);
  }

  .member--sofiya .member__photo {
    background:
      radial-gradient(circle at 70% 25%, color-mix(in oklch, var(--gold) 45%, transparent), transparent 55%),
      linear-gradient(150deg, var(--pink), var(--blush) 55%, var(--tan));
  }
  .member--angie .member__photo {
    background:
      radial-gradient(circle at 25% 75%, color-mix(in oklch, var(--burgundy) 25%, transparent), transparent 60%),
      linear-gradient(200deg, var(--cream), var(--pink) 50%, var(--blush));
  }
  .member--inna .member__photo {
    background:
      radial-gradient(circle at 75% 35%, color-mix(in oklch, var(--gold) 35%, transparent), transparent 55%),
      linear-gradient(135deg, var(--pink), var(--blush) 60%, var(--burgundy-soft));
  }

  .member__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 540px;
  }
  .member__eyebrow {
    color: var(--burgundy);
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0;
  }
  .member__name {
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(1.85rem, 3.6vw, 2.6rem);
    color: var(--ink);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .member__bio {
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 65ch;
  }
  .member__bio :global(p) { margin: 0 0 1rem; }
  .member__bio :global(p:last-child) { margin-bottom: 0; }

  @media (max-width: 880px) {
    .member {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3.5rem 0;
    }
    .member:nth-of-type(even) .member__media { order: 0; }
  }
</style>
