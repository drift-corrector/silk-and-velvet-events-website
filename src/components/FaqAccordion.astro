---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'faq'>[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map(async (item) => {
    const { Content } = await item.render();
    return (
      <details class="faq__item">
        <summary class="faq__q">{item.data.question}</summary>
        <div class="faq__a"><Content /></div>
      </details>
    );
  })}
</div>

<style>
  .faq {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq__item {
    background: var(--cream);
    border: 1px solid color-mix(in oklch, var(--ink) 6%, transparent);
    border-radius: var(--r-lg);
    padding: 1.25rem 1.5rem;
    transition: box-shadow 200ms;
  }
  .faq__item[open] { box-shadow: var(--shadow-sm); }
  .faq__q {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    line-height: 1.3;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after {
    content: '+';
    font-family: var(--sans);
    font-size: 1.5rem;
    color: var(--burgundy);
    transition: transform 200ms;
    flex: 0 0 auto;
  }
  .faq__item[open] .faq__q::after { content: '−'; }
  .faq__a {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .faq__a :global(p:first-child) { margin-top: 0; }
  .faq__a :global(p:last-child) { margin-bottom: 0; }
</style>
