---
import JsonLd from './JsonLd.astro';
import { ORG } from '~/lib/seo';

interface Props {
  name: string;
  description: string;
  priceFrom: number;
  url: string;
  serviceType?: string;
}
const { name, description, priceFrom, url, serviceType = 'Event Planning' } = Astro.props;

const data = {
  '@type': 'Service',
  serviceType,
  name,
  description,
  url,
  provider: { '@id': `${ORG.url}/#organization` },
  areaServed: ORG.serviceArea.map((n) => ({ '@type': 'Place', name: n })),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: priceFrom,
    priceSpecification: {
      '@type': 'PriceSpecification',
      priceCurrency: 'USD',
      minPrice: priceFrom,
    },
    availability: 'https://schema.org/InStock',
  },
};
---

<JsonLd data={data} />
