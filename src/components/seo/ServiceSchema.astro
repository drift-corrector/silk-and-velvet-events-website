---
import JsonLd from './JsonLd.astro';
import { ORG } from '~/lib/seo';

interface Props {
  name: string;
  description: string;
  url: string;
  serviceType?: string;
}
const { name, description, url, serviceType = 'Event Planning' } = Astro.props;

const data = {
  '@type': 'Service',
  serviceType,
  name,
  description,
  url,
  provider: { '@id': `${ORG.url}/#organization` },
  areaServed: ORG.serviceArea.map((n) => ({ '@type': 'Place', name: n })),
};
---

<JsonLd data={data} />
