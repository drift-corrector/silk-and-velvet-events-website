---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import SectionHead from '~/components/SectionHead.astro';
import ServiceTiles from '~/components/ServiceTiles.astro';
import GalleryGrid from '~/components/GalleryGrid.astro';
import ReviewsRow from '~/components/ReviewsRow.astro';
import ProcessStrip from '~/components/ProcessStrip.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import OrganizationSchema from '~/components/seo/OrganizationSchema.astro';
import LocalBusinessSchema from '~/components/seo/LocalBusinessSchema.astro';

import home from '~/data/pages/home.json';
import { featuredPhotos } from '~/lib/gallery';

const title = home.seoTitle;
const description = home.seoDescription;
const homePhotos = featuredPhotos(6);
---

<BaseLayout title={title} description={description}>
  <OrganizationSchema slot="head" />
  <LocalBusinessSchema slot="head" />

  <Hero />

  <section class="services" id="services">
    <SectionHead {...home.servicesSection} />
    <ServiceTiles />
  </section>

  <section class="gallery" id="gallery">
    <SectionHead
      eyebrow={home.gallerySection.eyebrow}
      title={home.gallerySection.title}
      sub={home.gallerySection.sub}
    />
    <GalleryGrid photos={homePhotos} />
    <p class="more"><a href="/gallery/" class="more__link">{home.gallerySection.ctaLabel} →</a></p>
  </section>

  <section class="reviews" id="reviews">
    <SectionHead {...home.reviewsSection} />
    <ReviewsRow limit={3} />
  </section>

  <section class="process" id="process">
    <SectionHead {...home.processSection} />
    <ProcessStrip />
  </section>

  <QuoteForm />
</BaseLayout>

<style>
  section { padding: 5rem 4rem; }
  .services { background: var(--paper); }
  .reviews { background: var(--pink-soft); }
  .more { text-align: center; margin-top: 2.5rem; }
  .more__link {
    color: var(--burgundy);
    font-weight: 500;
    border-bottom: 1.5px solid color-mix(in oklch, var(--burgundy) 30%, transparent);
    padding-bottom: 2px;
  }
  .more__link:hover { border-bottom-color: var(--burgundy); }
  @media (max-width: 600px) { section { padding: 3.5rem 1.5rem; } }
</style>
