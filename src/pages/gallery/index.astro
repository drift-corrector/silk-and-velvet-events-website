---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';
import BreadcrumbSchema from '~/components/seo/BreadcrumbSchema.astro';

import { categories, galleryPage } from '~/lib/gallery';

const title = galleryPage.seoTitle;
const description = galleryPage.seoDescription;

// Gradient fallbacks, cycled, for categories with no cover photo uploaded yet.
const VARIANTS = [2, 5, 4] as const;
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema slot="head" pathname={Astro.url.pathname} />

  <section class="gallery-hub">
    <SectionHead
      as="h1"
      eyebrow={galleryPage.eyebrow}
      title={galleryPage.title}
      sub={galleryPage.sub}
    />

    <div class="cats">
      {categories.map((c, i) => (
        <a
          class:list={['cat', { [`photo--${VARIANTS[i % VARIANTS.length]}`]: !c.cover }]}
          href={`/gallery/${c.slug}/`}
        >
          {c.cover && <img src={c.cover} alt={c.label} width="800" height="1000" />}
          <div class="cat__overlay">
            <h2>{c.label}</h2>
            <p>{c.cardSub}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-hub { padding: 5rem 4rem; }
  .cats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 1320px;
    margin: 0 auto;
  }
  .cat {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    position: relative;
    overflow: hidden;
    transition: transform 320ms ease;
    background: var(--blush);
  }
  .cat:hover { transform: scale(1.01); }
  .cat img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cat__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem;
    background: linear-gradient(to top, color-mix(in oklch, var(--ink) 75%, transparent), transparent);
    color: var(--cream);
  }
  .cat__overlay h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    margin: 0 0 0.25rem;
    font-weight: 400;
  }
  .cat__overlay p { margin: 0; font-size: 0.92rem; opacity: 0.9; }
  .photo--2 { background: linear-gradient(180deg, var(--burgundy), var(--burgundy-soft)); }
  .photo--4 { background: linear-gradient(140deg, var(--gold), var(--tan)); }
  .photo--5 { background: linear-gradient(170deg, var(--pink), var(--gold)); }
  @media (max-width: 880px) { .cats { grid-template-columns: 1fr; } .gallery-hub { padding: 3.5rem 1.5rem; } }
</style>
