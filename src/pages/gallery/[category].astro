---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';
import GalleryGrid from '~/components/GalleryGrid.astro';
import BreadcrumbSchema from '~/components/seo/BreadcrumbSchema.astro';

import { categories, photosFor, placeholderPhotos, galleryPage } from '~/lib/gallery';

export function getStaticPaths() {
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { label: c.label, description: c.seoDescription, sub: c.sub },
  }));
}

const { label, description, sub } = Astro.props;
const { category } = Astro.params;

const uploaded = photosFor(category!);
const photos = uploaded.length > 0 ? uploaded : placeholderPhotos(label);

const title = `${label} — Silk & Velvet Events`;
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema slot="head" pathname={Astro.url.pathname} />

  <section class="gallery-cat">
    <SectionHead as="h1" eyebrow={galleryPage.eyebrow} title={label} sub={sub} />
    <GalleryGrid photos={photos} />
    <p class="back"><a href="/gallery/">← All categories</a></p>
  </section>
</BaseLayout>

<style>
  .gallery-cat { padding: 5rem 4rem; }
  .back { text-align: center; margin-top: 2.5rem; color: var(--ink-soft); }
  .back a { color: var(--burgundy); font-weight: 500; }
  @media (max-width: 600px) { .gallery-cat { padding: 3.5rem 1.5rem; } }
</style>
