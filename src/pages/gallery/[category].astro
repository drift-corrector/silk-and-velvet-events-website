---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';
import GalleryGrid from '~/components/GalleryGrid.astro';
import BreadcrumbSchema from '~/components/seo/BreadcrumbSchema.astro';

export async function getStaticPaths() {
  return [
    {
      params: { category: 'wedding-details' },
      props: {
        label: 'Wedding Details',
        description: 'Wedding tablescapes, ceremony designs, and floral installs from Silk & Velvet Events across NYC, Long Island, and New Jersey.',
        sub: 'Tablescapes, ceremony moments, florals, and the small details guests remember.',
      },
    },
    {
      params: { category: 'event-decor' },
      props: {
        label: 'Event Decor',
        description: 'Birthday, milestone, and shower decor by Silk & Velvet Events. Real installs from the tri-state.',
        sub: 'Baby and bridal showers, milestone birthdays, holiday parties, corporate gatherings.',
      },
    },
    {
      params: { category: 'balloon-decor' },
      props: {
        label: 'Balloon Decor',
        description: 'Sculpted balloon arches, organics, and ceiling installs by Silk & Velvet Events. NYC, Long Island, NJ.',
        sub: 'Arches, garlands, organics, columns, and full-room ceiling treatments.',
      },
    },
  ];
}

const { label, description, sub } = Astro.props;

const photos = Array.from({ length: 9 }, (_, i) => ({
  alt: `${label} sample ${i + 1}`,
  caption: `${label} · ${i + 1}`,
  variant: ((i % 6) + 1) as 1 | 2 | 3 | 4 | 5 | 6,
}));

const title = `${label} — Silk & Velvet Events`;
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema slot="head" pathname={Astro.url.pathname} />

  <section class="gallery-cat">
    <SectionHead as="h1" eyebrow="Gallery" title={label} sub={sub} />
    <GalleryGrid photos={photos} />
    <p class="back"><a href="/gallery/">← All categories</a></p>
  </section>
</BaseLayout>

<style>
  .gallery-cat { padding: 5rem 4rem; }
  .back { text-align: center; margin-top: 2.5rem; color: var(--ink-soft); }
  .back a { color: var(--burgundy); font-weight: 500; }
  @media (max-width: 600px) { .gallery-cat { padding: 3.5rem 1.5rem; } }
</style>
