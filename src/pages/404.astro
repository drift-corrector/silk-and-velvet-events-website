---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';

const title = '404 — Page Not Found · Silk & Velvet Events';
const description = "We couldn't find that page. Try the homepage, or text Sofiya — she's faster than search.";
---

<BaseLayout title={title} description={description} noindex>
  <section class="four">
    <SectionHead as="h1" eyebrow="404" title="That page <em>got away.</em>" sub="It might have moved, or never existed. Either way — we'll point you back." />

    <div class="four__actions">
      <a class="btn btn--primary" href="/">Back to the homepage</a>
      <a class="btn btn--ghost" href="/contact/">Or text Sofiya</a>
    </div>
  </section>
</BaseLayout>

<style>
  .four { padding: 6rem 1.5rem; text-align: center; }
  .four__actions {
    display: inline-flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    padding: 0.85rem 1.5rem;
    border-radius: var(--r-pill);
    font-size: 0.95rem;
    font-weight: 500;
    border: none;
    transition: all 200ms;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn--primary { background: var(--burgundy); color: var(--cream); box-shadow: var(--shadow-sm); }
  .btn--primary:hover { background: oklch(0.36 0.16 5); transform: translateY(-1px); box-shadow: var(--shadow-md); }
  .btn--ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid color-mix(in oklch, var(--ink) 18%, transparent);
  }
  .btn--ghost:hover { background: var(--pink-soft); border-color: var(--burgundy); color: var(--burgundy); }
  .btn::after { content: '→'; }
</style>
