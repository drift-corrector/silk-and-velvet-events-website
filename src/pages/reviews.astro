---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';
import ReviewsRow from '~/components/ReviewsRow.astro';
import BreadcrumbSchema from '~/components/seo/BreadcrumbSchema.astro';

import page from '~/data/pages/reviews.json';

const title = page.seoTitle;
const description = page.seoDescription;
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema slot="head" pathname={Astro.url.pathname} />

  <section class="reviews">
    <SectionHead
      as="h1"
      eyebrow={page.eyebrow}
      title={page.title}
      sub={page.sub}
    />
    <ReviewsRow />
  </section>
</BaseLayout>

<style>
  .reviews { background: var(--pink-soft); padding: 5rem 4rem; }
  @media (max-width: 600px) { .reviews { padding: 3.5rem 1.5rem; } }
</style>
