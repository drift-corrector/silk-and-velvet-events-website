---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SectionHead from '~/components/SectionHead.astro';
import ServiceGroupSection from '~/components/ServiceGroupSection.astro';
import BreadcrumbSchema from '~/components/seo/BreadcrumbSchema.astro';

const title = 'Services — Silk & Velvet Events';
const description = 'Full-service planning, day-of coordination, event design, balloon décor, and à la carte support across New York City, Long Island, and New Jersey.';

const groups = (await getCollection('service-groups')).sort((a, b) => a.data.order - b.data.order);
const services = await getCollection('services');
---

<BaseLayout title={title} description={description}>
  <BreadcrumbSchema slot="head" pathname={Astro.url.pathname} />

  <section class="services-intro">
    <SectionHead
      as="h1"
      eyebrow="Services"
      title="Five places to <em>start.</em>"
      sub="Five ways we plug in — pick the one that matches where you are."
    />
  </section>

  <section class="services-detail">
    {groups.map((g) => (
      <ServiceGroupSection
        group={g}
        services={services}
        anchor={g.id.replace(/\.md$/, '')}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .services-intro { padding: 5rem 4rem 1rem; }
  .services-detail { padding: 1rem 4rem 5rem; }
  @media (max-width: 600px) {
    .services-intro { padding: 3.5rem 1.5rem 0.5rem; }
    .services-detail { padding: 0.5rem 1.5rem 3.5rem; }
  }
</style>
